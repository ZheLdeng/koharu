{
  "manifest_version": 3,
  "name": "Koharu Web Reader",
  "version": "0.1.0",
  "description": "Translate the visible manga image with Koharu and replace it on the page.",
  "key": "",
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:31785/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Translate visible manga image with Koharu",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
